; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is formatted here for Stage-Builder.

config_version=5

[application]

config/name="Stage-Builder"
config/description="Native desktop 3D simulator for designing event stages"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AppState="*res://scripts/core/app_state.gd"
CatalogManager="*res://scripts/core/catalog_manager.gd"
CommandManager="*res://scripts/core/command_manager.gd"
UIScale="*res://scripts/core/ui_scale.gd"
PerformanceSettings="*res://scripts/core/performance_settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/min_size=Vector2i(825, 510)
window/size/resizable=true
window/vsync/vsync_mode=1
window/dpi/allow_hidpi=true
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.12, 0.12, 0.14, 1)
